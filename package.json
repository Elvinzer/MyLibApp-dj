{
  "name": "mylibapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/launch.mjs --dev --no-open",
    "start": "node scripts/launch.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/tempo.test.mjs tests/ports.test.mjs tests/equalizer.test.mjs && .venv/bin/python -m pytest tests -q",
    "package:mac": ".venv/bin/python scripts/package-mac.py"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  }
}
